{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [ // NOTE: Please add as much information as possible to any items added to the allowList
    // lodash/lodash-es prototype pollution via _.unset/_.omit - transitive via @mojaloop/api-snippets>ts-auto-mock
    "GHSA-xxjr-mmjv-4gpg",
    // ajv ReDoS with $data option - transitive via @mojaloop/inter-scheme-proxy-cache-lib and eslint
    "GHSA-2g4f-4pwh-qvx6",
    // minimatch ReDoS vulnerabilities - transitive via eslint 8.x and replace (devDependencies)
    "GHSA-3ppc-4f35-3m26",
    "GHSA-7r86-cg39-jmmj",
    "GHSA-23c5-xmqv-rm74"
  ]
}
